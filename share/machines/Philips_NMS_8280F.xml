<?xml version="1.0" ?>
<!-- French variant of the NMS 8280, using dumps of the actual ROM chips (BIOS+BASIC IC119, disk ROM IC117 and the
     MSX2 sub-ROM). The sub-ROM differs from the NMS 8250 one in 114 bytes (code), the BIOS in the key/language tables. -->
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>Philips</manufacturer>
    <code>NMS 8280F</code>
    <release_year>1987</release_year>
    <description>European MSX2 with two disk drives and external video input (French version, French keyboard). Video digitization is emulated for the external video input.</description>
    <type>MSX2</type>
    <region>fr</region>
  </info>

  <MapperReadBackBits>largest</MapperReadBackBits>

  <CassettePort/>

  <devices>

    <PPI id="ppi">
      <sound>
        <volume>16000</volume>
      </sound>
      <io base="0xA8" num="8"/> <!-- S-3527 mirrors -->
      <keyboard_type>fr</keyboard_type>
      <has_keypad>true</has_keypad>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <version>V9938</version>
      <vram>128</vram>
      <io base="0x98" num="8" type="O"/> <!-- S-3527 mirrors -->
      <io base="0x98" num="8" type="I"/> <!-- S-3527 mirrors -->
    </VDP>

    <NMS8280Video id="Video control">
      <io base="0xF6" num="3" type="IO"/> <!-- F6: video mix, F7: mode select, F8: audio mix -->
    </NMS8280Video>

    <PSG id="PSG">
      <type>YM2149</type> <!-- in S-3527 MSX-ENGINE -->
      <sound>
        <volume>21000</volume>
      </sound>
      <io base="0xA0" num="8" type="IO"/> <!-- S-3527 mirrors -->
      <ignorePortDirections>true</ignorePortDirections> <!-- not sure, but guess based on use of Engine IC -->
    </PSG>

    <RTC id="Real time clock">
      <sramname>nms_8280f.cmos</sramname>
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
    </RTC>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="8" type="IO"/> <!-- S-3527 mirrors -->
      <status_readable_on_all_ports>true</status_readable_on_all_ports> <!-- S-3527 property -->
      <unused_bits>0x00</unused_bits> <!-- as measured on one NMS 8250 -->
    </PrinterPort>

    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <rom>
          <filename>nms8280f_basic-bios2.rom</filename>
          <sha1>b034764e6a8978db60b1d652917f5e24a66a7925</sha1>
        </rom>
        <mem base="0x0000" size="0x8000"/>
      </ROM>
    </primary>

    <primary external="true" slot="1"/>

    <primary external="true" slot="2"/>

    <primary slot="3">

      <secondary slot="0">
        <ROM id="MSX Sub ROM">
          <mem base="0x0000" size="0x10000"/> <!-- it is mirrored all over the slot -->
          <rom>
            <filename>nms8280f_msx2sub.rom</filename>
            <sha1>fd4bcc81a8160a1dea06036c5f79d200f948f4d6</sha1>
          </rom>
        </ROM>
      </secondary>

      <secondary slot="1"/>

      <secondary slot="2">
        <MemoryMapper id="Main RAM">
          <size>128</size>
          <initialContent encoding="gz-base64">eNpj+M8wouEI9z4DAJBx/wE=</initialContent> <!-- (chr(0) + chr(255)) * 128 + (chr(255)+ chr(0)) * 128) -->
          <mem base="0x0000" size="0x10000"/>
        </MemoryMapper>
      </secondary>

      <secondary slot="3">
        <WD2793 id="Memory Mapped FDC">
          <connectionstyle>Philips</connectionstyle>
          <mem base="0x0000" size="0x10000"/>
          <!-- Verified on a real 8250 and 8280: FDC registers are visible
               in all 4 pages, rom only in page 1. This is handled internally
               in the WD2793 device -->
          <rom_visibility base="0x4000" size="0x4000"/> <!-- ROM only visible in page 1 -->
          <drives>2</drives>
          <rom>
            <!-- Dump of the disk ROM chip; the last bytes (0x3FF8-0x3FFD) are FDC register reads and are not used. -->
            <filename>nms8280f_disk.rom</filename>
            <sha1>58ba1887e8fd21c912b6859cae6514bd874ffcca</sha1>
          </rom>
        </WD2793>
      </secondary>

    </primary>

  </devices>

</msxconfig>
